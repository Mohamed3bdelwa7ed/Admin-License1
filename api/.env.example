# --- License API environment ---

# HTTP port
PORT=4000

# MongoDB Atlas connection string (required).
# Create a free cluster at https://www.mongodb.com/cloud/atlas
#   Database > Connect > Drivers > copy the SRV string
#   add the database name to the path, e.g. ...mongodb.net/license_admin
# NEVER commit the real value. NEVER expose it to the React frontend or Madar.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/license_admin

# CORS origins allowed to call the admin API (comma-separated). Frontend URL in production.
# The running frontend MUST be listed here, otherwise browsers block it with:
#   "blocked by CORS policy: Response to preflight request doesn't pass access control check"
# Either variable works — they are merged. CORS_ORIGINS wins for multiple origins.
CORS_ORIGINS=http://localhost:5173,https://admin-licensev2.jamm7498.workers.dev
# Single-origin alias (same effect as listing it in CORS_ORIGINS above).
# Useful on hosts like Render where you set one "frontend URL" value.
FRONTEND_URL=https://admin-licensev2.jamm7498.workers.dev

# Admin bootstrap account (created/updated at server start if password set)
ADMIN_EMAIL=admin@madar.example
ADMIN_PASSWORD=
ADMIN_NAME=MoHashem

# JWT secret for admin access tokens
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Ed25519 signing keys for client (Madar) responses.
# Leave empty in development to auto-generate ephemeral keys.
# In production run `npm run keygen` and set all three values.
# The PRIVATE key stays server-side ONLY (never in React, never in Madar, never in MongoDB).
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=
LICENSE_SIGNING_KEY_ID=

# License defaults (also editable via the Settings API)
DEFAULT_DURATION_MONTHS=12
DEFAULT_MAX_DEVICES=2
VALIDATION_INTERVAL_HOURS=24
GRACE_PERIOD_DAYS=14

# Rate limiting (requests per minute, per IP)
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_CLIENT_PER_MINUTE=60
