{
  "name": "madar-license-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "License API for Madar POS licensing system",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "keygen": "tsx scripts/keygen.ts",
    "seed": "tsx scripts/seed.ts",
    "migrate:sqlite": "tsx scripts/migrate-sqlite-to-mongodb.ts"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
